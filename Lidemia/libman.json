{
    "version": "3.0",
    "defaultProvider": "cdnjs",
    "libraries": [
        {
            "library": "bootstrap@5.3.8",
            "destination": "wwwroot/lib/bootstrap/",
            "files": [
                "js/bootstrap.bundle.js",
                "css/bootstrap.css"
            ]
        },
        {
            "library": "microsoft-signalr@10.0.11",
            "destination": "wwwroot/lib/microsoft-signalr/",
            "files": [
                "signalr.js"
            ]
        },
        {
            "library": "tagify@4.39.0",
            "destination": "wwwroot/lib/tagify/"
        },
        {
            "library": "lodash.js@4.17.21",
            "destination": "wwwroot/lib/lodash.js/",
            "files": [
                "lodash.js"
            ]
        }
    ]
}
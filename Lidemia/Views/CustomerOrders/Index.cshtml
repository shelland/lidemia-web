@using Lidemia.Core.Extensions
@using Lidemia.Logic.Extensions
@using Lidemia.Resources.App
@using Microsoft.Extensions.Localization

@model Lidemia.Core.Models.Misc.BasePagedListModel<Lidemia.Core.Models.Domain.OrderModel>

@inject IStringLocalizer<AppResources> localizer

@{
    ViewData.SetTitle(localizer["CustomerOrdersPageTitle"]);
    ViewData.SetBigTitle(localizer["CustomerOrdersPageTitle"]);

    // var activeOrders=Model.Items.Where(x=>x.)
}

<ul class="nav nav-tabs nav-tabs-basic">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#active-orders-tab">@localizer["CustomerOrdersActiveOrders"]</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#history-orders-tab">@localizer["CustomerOrdersHistoryOrders"]</a>
    </li>
</ul>
<!-- /.nav-tabs -->
<div class="tab-content mt-0 mt-md-5">
    <div class="tab-pane fade show active" id="active-orders-tab">
        @if (Model.Items.Any())
        {
            <div class="job-list">

                @foreach (var order in Model.Items)
                {
                    <a href="@Url.Action("Details", "CustomerOrders", new { id = order.Id })" class="card mb-4 lift">
                        <div class="card-body p-5">
                            <span class="row justify-content-between align-items-center">
                                <span class="col-md-5 mb-2 mb-md-0 d-flex align-items-center text-body">
                                    <span class="avatar bg-pink text-white w-9 h-9 fs-17 me-3">NT</span> <span class="fw-bold">@order.Number</span>
                                </span>
                                <span class="col-5 col-md-3 text-body d-flex align-items-center">
                                    <i class="uil uil-clock me-1"></i> @order.Id
                                </span>
                                <span class="col-7 col-md-4 col-lg-3 text-body d-flex align-items-center">
                                    <i class="uil uil-location-arrow me-1"></i> @order.TotalSum.GetDisplayValue()
                                </span>
                                <span class="d-none d-lg-block col-1 text-center text-body">
                                    <i class="uil uil-angle-right-b"></i>
                                </span>
                            </span>
                        </div>
                    </a>
                }

            </div>
        }
        else
        {
            <h2>@localizer["CustomerOrdersNoItems"]</h2>
        }
    </div>
    <!--/.tab-pane -->
    <div class="tab-pane fade" id="history-orders-tab">
        ...
    </div>

</div>
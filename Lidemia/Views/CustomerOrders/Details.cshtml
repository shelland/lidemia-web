@using Lidemia.Logic.Extensions
@using Lidemia.Resources.App
@using Microsoft.Extensions.Localization

@model Lidemia.Core.Models.Domain.OrderModel

@inject IStringLocalizer<AppResources> localizer

@{
    var title = $"{localizer["CustomerOrdersPageTitle"]} {Model.Number}";
    ViewData.SetTitle(title);
    ViewData.SetBigTitle(title);
}

<div class="row gx-lg-8 gx-xl-12 gy-6 process-wrapper line">
    <div class="col-md-6 col-lg-3">
        <span class="icon btn btn-circle btn-lg btn-primary pe-none mb-4">
            <span class="number">01</span>
        </span>
        <h4 class="mb-1">@localizer["CustomerOrderStatusNew"]</h4>
        <p class="mb-0">@localizer["CustomerOrderStatusNewDesc"]</p>
    </div>
    <!--/column -->
    <div class="col-md-6 col-lg-3">
        <span class="icon btn btn-circle btn-lg btn-soft-primary pe-none mb-4">
            <span class="number">02</span>
        </span>
        <h4 class="mb-1">@localizer["CustomerOrderStatusProcessing"]</h4>
        <p class="mb-0">@localizer["CustomerOrderStatusProcessingDesc"]</p>
    </div>
    <!--/column -->
    <div class="col-md-6 col-lg-3">
        <span class="icon btn btn-circle btn-lg btn-soft-primary pe-none mb-4">
            <span class="number">03</span>
        </span>
        <h4 class="mb-1">@localizer["CustomerOrderStatusDelivering"]</h4>
        <p class="mb-0">@localizer["CustomerOrderStatusDeliveringDesc"]</p>
    </div>
    <!--/column -->
    <div class="col-md-6 col-lg-3">
        <span class="icon btn btn-circle btn-lg btn-soft-primary pe-none mb-4">
            <span class="number">04</span>
        </span>
        <h4 class="mb-1">@localizer["CustomerOrderStatusFinished"]</h4>
        <p class="mb-0">@localizer["CustomerOrderStatusFinishedDesc"]</p>
    </div>
    <!--/column -->
</div>

@foreach (var gr in Model.Items.GroupBy(x => x.Product.Supplier.Name))
{
    <h3 class="display-3 mt-3">@gr.Key</h3>
    <hr class="hr-gradient"/>
    @foreach (var subGr in gr)
    {
        <div class="card col-lg-2">
            <a target="_blank" href="@Url.Action("Details", "Products", new { id = subGr.Product.Id })">
                <img class="card-img-top" src="@subGr.Product.PrimaryPhoto.OriginalFilePath" alt=""/>
            </a>
            <div class="card-body">
                @subGr.Product.Title
            </div>
            <!--/.card-body -->
        </div>
        <!--/.card -->
    }
}


@using Lidemia.Logic.Extensions
@using Lidemia.Resources.App
@using Microsoft.Extensions.Localization

@model Lidemia.Core.Models.Domain.SupplierModel

@inject IStringLocalizer<AppResources> localizer

@{
    ViewData.SetBigTitle(localizer["EditSupplierProfilePageTitle"]);
}

<label for="name" class="form-label">@localizer["EditSupplierProfileName"]</label>
<input type="text" class="form-control form-control-lg fw-bold" value="@Model.Name" disabled="disabled" id="name"/>
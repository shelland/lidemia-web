@using Lidemia.Core.Enums
@using Lidemia.Core.Extensions
@using Lidemia.Logic.Extensions
@using Lidemia.Resources.App
@using Microsoft.Extensions.Localization

@model Lidemia.ViewModels.CheckoutViewModel

@inject IStringLocalizer<AppResources> localizer

@{
    ViewData.SetTitle(localizer["CustomerCheckoutPageTitle"]);
    ViewData.SetBigTitle(localizer["CustomerCheckoutPageTitle"]);

    var hasDeliveryItems = Model.Items.SelectMany(x => x.Value).Any(x => x.Product.DeliveryTypes?.Contains(DeliveryType.Delivery) == true);
}

@if (Model.Items.Any())
{
    @foreach (var supplierProducts in Model.Items)
    {
        <div data-supplier-id="@supplierProducts.Key.SupplierId" class="supplier-group">

            @foreach (var product in supplierProducts.Value)
            {
                <div class="col-lg-12 product-row">
                    <h2>@supplierProducts.Key.SupplierName</h2>
                    <strong>@product.Qty</strong>
                    <a href="@Url.Action("Details", "Products", new { id = product.Product.Id })" target="_blank">
                        <strong>@product.Product.Title</strong>
                    </a>

                    <b>@product.Product.DeliveryTypes?.FirstOrDefault().GetLocalizedDisplayName()</b>

                    @if (product.Product.HasCurrentDiscount)
                    {
                        <p class="price">
                            <del>
                                <span class="amount">@product.Product.Price &#8381;</span>
                            </del>
                            <ins>
                                <span class="amount">@product.Product.DiscountPrice &#8381;</span>
                            </ins>
                        </p>
                    }
                    else
                    {
                        <p class="price">
                            <span class="amount">@product.Product.Price &#8381;</span>
                        </p>
                    }

                    @if (product.Product.DeliveryTypes?.Contains(DeliveryType.SelfPickup) == true)
                    {
                        <label class="form-label" for="supplierAddress@(supplierProducts.Key.SupplierId)">@localizer["CheckoutSupplierSelfPickupAddress"]</label>
                        <select id="supplierAddress@(supplierProducts.Key.SupplierId)" class="form-control form-control-lg w-100 supplier-address" data-supplier-id="@supplierProducts.Key.SupplierId">

                            @foreach (var address in supplierProducts.Key.Addresses)
                            {
                                <option value="@address.Id">@address.ToString()</option>
                            }

                        </select>
                    }

                </div>
            }

            <hr/>
        </div>
    }

    @if (hasDeliveryItems)
    {
        if (Model.CustomerAddresses.Any())
        {
            <div class="col-lg-12">
                <label for="customerAddress" class="form-label">@localizer["CheckoutCustomerDeliveryAddress"]</label>
                <select id="customerAddress" class="form-control form-control-lg w-100 mb-3">

                    @foreach (var address in Model.CustomerAddresses)
                    {
                        <option value="@address.Id">@address.ToString()</option>
                    }

                </select>
            </div>
        }
        else
        {
            <p>@localizer["CheckoutAddCustomerAddressText"]</p>
            <a class="btn btn-secondary" href="@Url.Action("Create", "CustomerAddresses")">@localizer["CheckoutAddCustomerAddress"]</a>
        }
    }
}
else
{
    <h1>@localizer["CheckoutNoItems"]</h1>
}


<div class="row">
    <div class="col-lg-12">
        @if (Model.Total != Model.DiscountTotal)
        {
            <p class="price">
                <del>
                    <span class="amount">@Model.Total &#8381;</span>
                </del>
                <ins>
                    <span class="amount">@Model.DiscountTotal &#8381;</span>
                </ins>
            </p>
        }
        else
        {
            <p class="price">
                <span class="amount">@Model.Total &#8381;</span>
            </p>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <a href="javascript:;" class="btn btn-primary mb-3 mt-3" id="saveBtn">@localizer["CheckoutSaveOrder"]</a>
        <a href="@Url.Action("Index", "CustomerShoppingCart")" class="btn btn-secondary mb-3 mt-3">@localizer["CheckoutBackToCart"]</a>
    </div>
</div>

@section Scripts
{
    <script src="~/Pages/Scripts/Checkout.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            Checkout.init({
                urls: {
                    checkoutUrl: '@Url.Action("Post", "CustomerCheckout")',
                    verifyCartUrl: '@Url.Action("VerifyCart", "CustomerCheckout")',
                    finishUrl: '@Url.Action("Finish", "CustomerCheckout", new { id = (long?)null })'
                }
            })

        });

    </script>
}

<link rel="stylesheet" href="~/Pages/Styles/Checkout.css"/>
@using Lidemia.Core.Extensions
@using Lidemia.Resources.App
@using Microsoft.Extensions.Localization

@model IEnumerable<Lidemia.Core.Models.Misc.ShoppingCartItem>

@{
}

@inject IStringLocalizer<AppResources> localizer

<div class="shopping-cart">
    
    @foreach (var item in Model)
    {
        <div class="shopping-cart-item d-flex justify-content-between mb-4">
            <div class="d-flex flex-row">
                <figure class="rounded w-17">
                    <a href="@Url.Action("Details", "Products", new { id = item.Product.Id })">
                        <img src="@item.Product.PrimaryPhoto?.OriginalFilePath" alt="" />
                    </a>
                </figure>
                <div class="w-100 ms-4">
                    <h3 class="post-title fs-16 lh-xs mb-1">
                        <a href="@Url.Action("Details", "Products", new { id = item.Product.Id })" class="link-dark">@item.Product.Title</a>
                    </h3>
                    <p class="price fs-sm">
                        
                        @if (item.Product.HasCurrentDiscount)
                        {
                            <del>
                                <span class="amount">@item.Product.Price.GetDisplayValue()</span>
                            </del>
                            <ins>
                                <span class="amount">@item.Product.DiscountPrice?.GetDisplayValue()</span>
                            </ins>
                        }
                        else
                        {
                            <span class="amount">@item.Product.Price?.GetDisplayValue()</span>
                        }
                        
                    </p>
                </div>
            </div>
            <div class="ms-2">
                <a href="#" class="link-dark">
                    <i class="uil uil-trash-alt"></i>
                </a>
            </div>
        </div>
    }

</div>
<!-- /.shopping-cart-->
<div class="offcanvas-footer flex-column text-center">
    <div class="d-flex w-100 justify-content-between mb-4">
        <span>Subtotal:</span>
        <span class="h6 mb-0">$135.99</span>
    </div>
    <a href="@Url.Action("Index", "CustomerShoppingCart")" class="btn btn-primary btn-icon btn-icon-start rounded w-100 mb-4"><i class="uil uil-credit-card fs-18"></i> @localizer["TopMenuCartGoToCart"]</a>
    @* <p class="fs-14 mb-0">Free shipping on all orders over $50</p> *@
</div>


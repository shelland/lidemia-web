@using Lidemia.Logic.Extensions
@using Lidemia.Resources.App
@using Microsoft.Extensions.Localization

@model Lidemia.ViewModels.ShoppingCartViewModel
@inject IStringLocalizer<AppResources> localizer

@{
    ViewData.SetTitle(localizer["ShoppingCartPageTitle"]);
}

@if (Model.Items != null)
{
    <div class="row">
        
        @foreach (var item in Model.Items)
        {
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-4">
                        <a href="@Url.Action("Details", "Products", new { id = item.Product.Id })">@item.Product.Title</a>
                    </div>
                    <div class="col-md-4">
                        COL 2
                    </div>
                    <div class="col-md-4">
                        <input type="text" value="@item.Qty"/>
                    </div>
                </div>
            </div>
        }

    </div>
}
else
{
    <h1>@localizer["ShoppingCartEmpty"]</h1>
}

@section Scripts
{
    <script src="~/Pages/Scripts/ShoppingCart.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function() {
            ShoppingCart.init({
                urls: {
                    addToCartUrl: '@Url.Action("Post")'
                },
                values: {

                }
            })
        });

    </script>
}
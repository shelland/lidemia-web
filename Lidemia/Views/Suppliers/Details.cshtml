@using Lidemia.Core.Enums
@using Lidemia.Logic.Extensions
@using Lidemia.Resources.App
@using Lidemia.Web.BusinessLogic.Services.Abstract
@using Microsoft.Extensions.Localization

@inject ICurrentUserService currentUserService
@inject IStringLocalizer<AppResources> localizer

@model Lidemia.ViewModels.SupplierDetailsViewModel

@{
    ViewData.SetTitle(Model.Supplier.Name);
    ViewData.SetBigTitle(Model.Supplier.Name);

    var currentEntity = await currentUserService.GetUser();
    var showDirectMessageButton = currentEntity?.Role != EntityType.Supplier;
}

<div class="row">
    <div class="col-xl-12 col-xxl-12 mx-auto">
        @if (showDirectMessageButton)
        {
            <div class="row mb-6">
                <div class="col-12 d-flex justify-content-end">
                    <a href="@Url.Action("Start", "Direct", new { supplierId = Model.Supplier.Id })" class="btn btn-primary rounded-pill">
                        <i class="uil uil-comments-alt me-2"></i>@localizer["SupplierDetailsSendMessage"]
                    </a>
                </div>
            </div>
        }
        <div class="row align-items-center justify-content-center counter-wrapper gy-6">
            <div class="col-md-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-row align-items-center">
                            <div>
                                <div class="icon btn btn-circle btn-lg btn-soft-red pe-none mx-auto me-4 mb-lg-3 mb-xl-0">
                                    <i class="uil uil-users-alt"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="counter mb-1">@Model.TotalOrders</h3>
                                <p class="mb-0">@localizer["SupplierDetailsTotalOrders"]</p>
                            </div>
                        </div>
                    </div>
                    <!--/.card-body -->
                </div>
                <!--/.card -->
            </div>
            <!--/column -->
            <div class="col-md-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-row align-items-center">
                            <div>
                                <div class="icon btn btn-circle btn-lg btn-soft-leaf pe-none mx-auto me-4 mb-lg-3 mb-xl-0">
                                    <i class="uil uil-user-check"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="counter mb-1">@Model.TotalProducts</h3>
                                <p class="mb-0">@localizer["SupplierDetailsTotalProducts"]</p>
                            </div>
                        </div>
                    </div>
                    <!--/.card-body -->
                </div>
                <!--/.card -->
            </div>
            <!--/column -->
            <div class="col-md-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-row align-items-center">
                            <div>
                                <div class="icon btn btn-circle btn-lg btn-soft-primary pe-none mx-auto me-4 mb-lg-3 mb-xl-0">
                                    <i class="uil uil-trophy"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="counter mb-1">@Model.AverageRate</h3>
                                <p class="mb-0">@localizer["SupplierDetailsAvgRate"]</p>
                            </div>
                        </div>
                    </div>
                    <!--/.card-body -->
                </div>
                <!--/.card -->
            </div>
            <!--/column -->
        </div>
        <!--/.row -->
    </div>
    <!-- /column -->
</div>
<!-- /.row -->
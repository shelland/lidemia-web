@using Lidemia.Resources.App
@using Microsoft.Extensions.Localization
@model Lidemia.ViewModels.ProductDetailsViewModel

@inject IStringLocalizer<AppResources> localizer


<div class="row gx-md-8 gx-xl-12 gy-8">

    <div class="col-lg-6">

        <div class="swiper-container swiper-thumbs-container" data-margin="10" data-dots="false" data-nav="true" data-thumbs="true">
            <div class="swiper">
                <div class="swiper-wrapper">

                    @foreach (var photo in Model.Photos)
                    {
                        <div class="swiper-slide">
                            <figure class="rounded">
                                <img src="@photo.OriginalFilePath" alt="@Model.Product.Title"/>
                                <a class="item-link" href="@photo.OriginalFilePath" data-glightbox data-gallery="product-group">
                                    <i class="uil uil-focus-add"></i>
                                </a>
                            </figure>
                        </div>
                    }

                </div>
            </div>

            <div class="swiper swiper-thumbs">
                <div class="swiper-wrapper">

                    @foreach (var photo in Model.Photos)
                    {
                        <div class="swiper-slide">
                            <img src="@photo.OriginalFilePath" srcset="@photo.OriginalFilePath 2x" class="rounded" alt=""/>
                        </div>
                    }

                </div>
            </div>
        </div>


    </div>

    <div class="col-lg-6">
        <div class="post-header mb-5">
            <h2 class="post-title display-5">
                <a href="@Url.Action("Details", "Products", new { id = Model.Product.Id })" class="link-dark">
                    @Model.Product.Title
                </a>
                <p class="price fs-20 mb-2">
                    <span class="amount">@Model.Product.Price</span>
                </p>
                <a href="#" class="link-body ratings-wrapper">
                    <span class="ratings four"></span><span>(3 Reviews)</span>
                </a>
            </h2>
        </div>
    </div>

</div>

@foreach (var tag in Model.Product.Tags)
{
    <a class="btn btn-secondary" href="@Url.Action("Index", "Products", new { tag = tag })">@tag</a>
}

<ul class="nav nav-tabs nav-pills">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#tab1-1">
            <i class="uil uil-phone-volume pe-1"></i>
            <span>@localizer["ProductsDetailsDescription"]</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab1-2">
            <i class="uil uil-shield-exclamation pe-1"></i>
            <span>@localizer["ProductDetailsSpec"]</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab1-3">
            <i class="uil uil-laptop-cloud pe-1"></i>
            <span>@localizer["ProductDetailsFeedback"]</span>
        </a>
    </li>
</ul>
<!-- /.nav-tabs -->

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab1-1">
        ...
    </div>
    <!--/.tab-pane -->
    <div class="tab-pane fade" id="tab1-2">
        ...
    </div>
    <!--/.tab-pane -->
    <div class="tab-pane fade" id="tab1-3">
        ...
    </div>
    <!--/.tab-pane -->
</div>
<!-- /.tab-content -->



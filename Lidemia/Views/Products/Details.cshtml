@using Lidemia.Resources.App
@using Microsoft.Extensions.Localization

@model Lidemia.ViewModels.ProductDetailsViewModel

@inject IStringLocalizer<AppResources> localizer

<div class="row gx-md-8 gx-xl-12 gy-8">

    <div class="col-lg-6">

        <div class="swiper-container swiper-thumbs-container" data-margin="10" data-dots="false" data-nav="true" data-thumbs="true">
            <div class="swiper">
                <div class="swiper-wrapper">

                    @foreach (var photo in Model.Photos)
                    {
                        <div class="swiper-slide">
                            <figure class="rounded">
                                <img src="@photo.OriginalFilePath" alt="@Model.Product.Title"/>
                                <a class="item-link" href="@photo.OriginalFilePath" data-glightbox data-gallery="product-group">
                                    <i class="uil uil-focus-add"></i>
                                </a>
                            </figure>
                        </div>
                    }

                </div>
            </div>

            <div class="swiper swiper-thumbs">
                <div class="swiper-wrapper">

                    @foreach (var photo in Model.Photos)
                    {
                        <div class="swiper-slide">
                            <img src="@photo.OriginalFilePath" srcset="@photo.OriginalFilePath 2x" class="rounded" alt=""/>
                        </div>
                    }

                </div>
            </div>
        </div>


    </div>

    <div class="col-lg-6">
        <div class="post-header mb-5">
            <h2 class="post-title display-5">
                <a href="@Url.Action("Details", "Products", new { id = Model.Product.Id })" class="link-dark">
                    @Model.Product.Title
                </a>
                <p class="price fs-20 mb-2">
                    <span class="amount">@Model.Product.Price &#8381;</span>
                </p>
                <a href="#" class="link-body ratings-wrapper">
                    <span class="ratings four"></span><span>(3 Reviews)</span>
                </a>
            </h2>
        </div>

        @if (Model.IsAbleToPurchase)
        {
            <div class="row">
                <div class="col-lg-9 d-flex flex-row pt-2">
                    <div>
                        <div class="form-select-wrapper">
                            @* <select class="form-select" id="qty">
                                <option value="1" selected>1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                            </select> *@
                            <input type="number" value="@Model.ItemsInCart" id="qty" class="form-control"/>
                        </div>
                    </div>
                    <div class="flex-grow-1 mx-2">
                        <button class="btn btn-primary btn-icon btn-icon-start rounded w-100 flex-grow-1" onclick="ProductDetails.addToCart()">
                            <i class="uil uil-shopping-bag"></i> @localizer["ProductDetailsAddToCart"]
                        </button>
                    </div>
                    <div>
                        <button class="btn btn-block btn-red btn-icon rounded px-3 w-100 h-100" onclick="ProductDetails.addToWishList()">
                            <i class="uil uil-heart"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
        
    </div>

</div>


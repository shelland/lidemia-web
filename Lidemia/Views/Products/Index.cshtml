@using Lidemia.Resources.App
@using Microsoft.Extensions.Localization

@model Lidemia.ViewModels.ProductsListViewModel

@inject IStringLocalizer<AppResources> localizer

@functions
{
    double? GetCartQty(long id)
    {
        return Model.CartItems?.TryGetValue(id, out var qty) == true ? qty : null;
    }
}

<div class="row gy-10">
    <div class="col-lg-9 order-lg-2">
        <div class="row align-items-center mb-10 position-relative zindex-1">
            <div class="col-md-7 col-xl-8 pe-xl-20">
                <h2 class="display-6 mb-1">New Arrivals</h2>
                <p class="mb-0 text-muted">Showing 1–9 of 30 results</p>
            </div>
            <!--/column -->
            <div class="col-md-5 col-xl-4 ms-md-auto text-md-end mt-5 mt-md-0">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-primary d-lg-none flex-shrink-0" data-bs-toggle="modal" data-bs-target="#productFiltersModal" aria-controls="productFiltersModal">
                        <i class="uil uil-bars me-2"></i>Filters
                    </button>
                    <div class="form-select-wrapper flex-grow-1">
                        <select class="form-select">
                            <option value="popularity">Sort by popularity</option>
                            <option value="rating">Sort by average rating</option>
                            <option value="newness">Sort by newness</option>
                            <option value="price(low)">Sort by price: low to high</option>
                            <option value="price(high)">Sort by price: high to low</option>
                        </select>
                    </div>
                    <!--/.form-select-wrapper -->
                </div>
            </div>
            <!--/column -->
        </div>
        <!--/.row -->
        <div class="grid grid-view projects-masonry shop mb-13">
            <div class="row gx-md-8 gy-10 gy-md-13 isotope">
                @foreach (var product in Model.Items)
                {
                    <div class="project item col-md-6 col-xl-4">
                        <figure class="rounded mb-6">
                            <img src="@product.PrimaryPhoto.OriginalFilePath" alt="" />
                            <a class="item-like" href="#" data-bs-toggle="white-tooltip" title="@localizer["ProductsListAddToWishList"]">
                                <i class="uil uil-heart"></i>
                            </a>
                            <a class="item-view" href="javascript:;" onclick="ProductsList.showPreview('@product.Id')" data-bs-toggle="white-tooltip" title="Quick view">
                                <i class="uil uil-eye"></i>
                            </a>
                            <a href="javascript:;" onclick="ProductsList.addToCart('@product.Id')" class="item-cart">

                                @{
                                    var hasItem = GetCartQty(product.Id);
                                }

                                @if (hasItem != null)
                                {
                                    <text>@hasItem ITEMS IN CART</text>
                                }
                                else
                                {
                                    <text><i class="uil uil-shopping-bag"></i> @localizer["ProductsListAddToCart"]</text>
                                }

                            </a>
                            <span class="avatar bg-pink text-white w-10 h-10 position-absolute text-uppercase fs-13" style="top: 1rem; left: 1rem;">
                                <span>Sale!</span>
                            </span>
                        </figure>
                        <div class="post-header">
                            <div class="d-flex flex-row align-items-center justify-content-between mb-2">
                                <div class="post-category text-ash mb-0">Shoes</div>
                                <span class="ratings five"></span>
                            </div>
                            <h2 class="post-title h3 fs-22">
                                <a href="@Url.Action("Details", "Products", new { id = product.Id, slug = product.Slug })" class="link-dark">@product.Title</a>
                            </h2>
                            <p class="price">

                                @if (product.HasCurrentDiscount)
                                {
                                    <del>
                                        <span class="amount">@product.Price &#8381;</span>
                                    </del>
                                    <ins>
                                        <span class="amount">@product.DiscountPrice &#8381;</span>
                                    </ins>
                                }
                                else
                                {
                                    <p class="price">
                                        <span class="amount">@product.Price &#8381;</span>
                                    </p>
                                }

                            </p>
                        </div>
                    </div>
                }
                <!-- /.item -->
            </div>
            <!-- /.row -->
        </div>
        <!-- /.grid -->
        <nav class="d-flex" aria-label="pagination">
            <ul class="pagination">
                <li class="page-item disabled">
                    <a class="page-link" href="#" aria-label="Previous">
                        <span aria-hidden="true">
                            <i class="uil uil-arrow-left"></i>
                        </span>
                    </a>
                </li>
                <li class="page-item active">
                    <a class="page-link" href="#">1</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#">2</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#">3</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#" aria-label="Next">
                        <span aria-hidden="true">
                            <i class="uil uil-arrow-right"></i>
                        </span>
                    </a>
                </li>
            </ul>
            <!-- /.pagination -->
        </nav>
        <!-- /nav -->
    </div>

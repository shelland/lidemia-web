<div class="modal fade" id="productFiltersModal" tabindex="-1" aria-labelledby="productFiltersModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productFiltersModalTitle">Filters</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="productFiltersModalBody"></div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/Pages/Scripts/ProductsFilters.js"></script>
    <script src="~/Pages/Scripts/ProductsList.js"></script>

    <script>

          document.addEventListener("DOMContentLoaded", function() {

            ProductsFilters.init({
        sidebarSelector: "#productsFiltersSidebar",
                modalSelector: "#productFiltersModal",
            modalBodySelector: "#productFiltersModalBody"
            });

        });

    </script>
}
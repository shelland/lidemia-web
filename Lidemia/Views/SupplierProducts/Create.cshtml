    <script>

        var product = @(Model.Product != null ? Html.Raw(productObject.Serialize()) : "null");
        
        const hashtagRegex = /^#[\p{Script=Cyrl}\p{Script=Latn}\d_-]+$/u;

        console.log(hashtagRegex.test("#nature"));         // true (Latin)
        console.log(hashtagRegex.test("#природа"));        // true (Cyrillic)
        console.log(hashtagRegex.test("#tech-news_2026")); // true (Mixed with - and _)

        // Invalid cases
        console.log(hashtagRegex.test("nature"));          // false (Missing #)
        console.log(hashtagRegex.test("#nature!"));        // false (Contains invalid symbol '!')
        console.log(hashtagRegex.test("#"));


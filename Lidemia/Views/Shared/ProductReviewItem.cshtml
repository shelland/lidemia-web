@model Lidemia.Core.Models.Domain.ProductReviewModel

<li class="comment">
    <div class="comment-header d-md-flex align-items-center">
        <div class="d-flex align-items-center">
            <figure class="user-avatar">
                @* <img class="rounded-circle" alt="" src="./assets/img/avatars/u1.jpg"/> *@
                @await Html.PartialAsync($"FaceIcon{Model.Rate}")
            </figure>
            <div>
                <h6 class="comment-author">
                    <a href="#" class="link-dark">@Model.Customer.ToString()</a>
                </h6>
                <ul class="post-meta">
                    <li>
                        <i class="uil uil-calendar-alt"></i>@Model.CreateDate
                    </li>
                </ul>
                <!-- /.post-meta -->
            </div>
            <!-- /div -->
        </div>
        <!-- /div -->
        <div class="mt-3 mt-md-0 ms-auto">
            @* <a href="#" class="btn btn-soft-ash btn-sm rounded-pill btn-icon btn-icon-start mb-0"><i class="uil uil-comments"></i> Reply</a> *@
        </div>
        <!-- /div -->
    </div>
    <!-- /.comment-header -->
    <p>
        @Model.Review
    </p>
    
    @if (!string.IsNullOrEmpty(Model.PositiveReview))
    {
        <p>
            @Model.PositiveReview
        </p>
    }
    
    @if (!string.IsNullOrEmpty(Model.NegativeReview))
    {
        <p>
            @Model.NegativeReview
        </p>
    }

</li>